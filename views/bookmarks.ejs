cat > views/bookmarks.ejs << 'EJS'
<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yer İmlerim</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="logo">📢 Forum</a>
    <div class="nav-right">
      <a href="/messages" class="btn-small">💬 Mesajlar</a>
      <a href="/friends" class="btn-small">👥 Arkadaşlar</a>
      <a href="/profile/<%= user %>" class="btn-small">👤 <%= user %></a>
      <a href="/logout" class="btn-small danger">Çıkış</a>
    </div>
  </nav>

  <div class="container">
    <a href="/" class="back-link">← Geri</a>
    <h2>🔖 Yer İmlerim</h2>

    <% if (posts.length === 0) { %>
      <div class="card empty">Henüz yer imi eklemedin.</div>
    <% } %>
    <% posts.forEach(p => { %>
      <div class="card post-card">
        <div class="post-header">
          <a href="/post/<%= p.id %>" class="post-title"><%= p.title %></a>
          <span class="badge"><%= p.category %></span>
        </div>
        <p><%= p.content.substring(0, 120) %><%= p.content.length > 120 ? '...' : '' %></p>
        <div class="post-footer">
          <span>👤 <a href="/profile/<%= p.author %>"><%= p.author %></a></span>
          <span>🕐 <%= p.date %></span>
          <span>❤️ <%= p.likes %></span>
        </div>
      </div>
    <% }) %>
  </div>
</body>
</html>
EJS