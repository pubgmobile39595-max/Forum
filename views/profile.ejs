<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= profile.username %> - Profil</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="logo">📢 Forum</a>
    <button class="menu-toggle" onclick="document.querySelector('.nav-right').classList.toggle('open')">☰</button>
    <div class="nav-right">
      <a href="/users" class="btn-small">👥 Üyeler</a>
      <a href="/leaderboard" class="btn-small">🏆 Liderlik</a>
      <a href="/activity" class="btn-small">⚡ Aktif</a>
      <a href="/friends" class="btn-small">👫 Arkadaşlar</a>
      <a href="/messages" class="btn-small">💬 Mesajlar</a>
      <% if (user) { %>
        <a href="/notifications" class="btn-small">🔔 <% if (notifCount > 0) { %><span class="badge-red"><%= notifCount %></span><% } %></a>
        <% if (isAdmin) { %><a href="/admin" class="btn-small">👑</a><% } %>
        <a href="/profile/<%= user %>" class="btn-small">👤 <%= user %></a>
        <a href="/logout" class="btn-small danger">Çıkış</a>
      <% } %>
    </div>
  </nav>

  <div class="container">
    <a href="/" class="back-link">← Geri</a>

    <div class="card profile-header">
      <% if (profile.avatar) { %>
        <img src="<%= profile.avatar %>" class="avatar-img" alt="avatar">
      <% } else { %>
        <div class="avatar">👤</div>
      <% } %>
      <h1>
        <%= profile.username %>
        <% if (profile.role === 'admin') { %> <span class="badge">👑 Admin</span><% } %>
        <% if (profile.role === 'mod') { %> <span class="badge">🛡️ Mod</span><% } %>
        <% if (profile.banned) { %> <span class="badge-red">🚫 Yasaklı</span><% } %>
      </h1>

      <% if (badges && badges.length > 0) { %>
        <div class="badges-row">
          <% badges.forEach(b => { %>
            <span class="badge badge-<%= b %>">
              <% if (b === 'yeni') { %>🌱 Yeni
              <% } else if (b === 'aktif') { %>⚡ Aktif
              <% } else if (b === 'usta') { %>🎯 Usta
              <% } else if (b === 'efsane') { %>🔥 Efsane
              <% } else { %><%= b %>
              <% } %>
            </span>
          <% }) %>
        </div>
      <% } %>

      <p class="bio"><%= profile.bio || 'Henüz biyografi yok.' %></p>

      <div class="stats">
        <div><b><%= posts.length %></b><span>Konu</span></div>
        <div><b><%= commentCount %></b><span>Yorum</span></div>
        <div><b><%= followerCount %></b><span>Takipçi</span></div>
        <div><b><%= followingCount %></b><span>Takip</span></div>
        <div><b>⚡ <%= profile.points %></b><span>Puan</span></div>
      </div>

      <% if (user && user !== profile.username) { %>
        <div class="profile-actions">
          <form action="/follow/<%= profile.username %>" method="POST" style="display:inline">
            <button class="btn <%= isFollowing ? 'secondary' : '' %>">
              <%= isFollowing ? '👥 Takibi Bırak' : '➕ Takip Et' %>
            </button>
          </form>
          <a href="/messages/<%= profile.username %>" class="btn">💬 Mesaj Gönder</a>
          <form action="/friend-request/<%= profile.username %>" method="POST" style="display:inline">
            <button class="btn">🤝 Arkadaş Ekle</button>
          </form>
          <form action="/block/<%= profile.username %>" method="POST" style="display:inline"
                onsubmit="return confirm('Bu kullanıcıyı engellemek istediğine emin misin?')">
            <button class="btn danger">🚫 Engelle</button>
          </form>
        </div>
      <% } %>

      <% if (user === profile.username) { %>
        <div class="profile-actions">
          <a href="/settings" class="btn secondary">⚙️ Ayarlar</a>
          <a href="/messages" class="btn secondary">💬 Mesajlarım</a>
          <a href="/friends" class="btn secondary">👫 Arkadaşlarım</a>
          <a href="/bookmarks" class="btn secondary">🔖 Yer İmlerim</a>
        </div>

        <form action="/profile/update" method="POST" class="bio-form">
          <textarea name="bio" placeholder="Kendinden bahset..." rows="2"><%= profile.bio %></textarea>
          <input name="email" type="email" placeholder="E-posta" value="<%= profile.email || '' %>">
          <button class="btn">💾 Güncelle</button>
        </form>

        <form action="/profile/avatar" method="POST" enctype="multipart/form-data" class="bio-form">
          <input type="file" name="avatar" accept="image/*" required>
          <button class="btn">📷 Avatar Yükle</button>
        </form>
      <% } %>
    </div>

    <h3>📝 Konuları</h3>
    <% if (posts.length === 0) { %>
      <div class="card empty">Henüz konu açmamış.</div>
    <% } %>
    <% posts.forEach(p => { %>
      <div class="card">
        <div class="post-header">
          <a href="/post/<%= p.id %>" class="post-title">
            <% if (p.pinned) { %>📌 <% } %>
            <% if (p.locked) { %>🔒 <% } %>
            <%= p.title %>
          </a>
          <span class="badge"><%= p.category %></span>
        </div>
        <div class="post-footer">
          <span>🕐 <%= p.date %></span>
          <span>❤️ <%= p.likes %></span>
          <span>👁️ <%= p.views %></span>
        </div>
      </div>
    <% }) %>
  </div>
</body>
</html>
